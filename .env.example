# Slash optional LLM + GitHub keys — copy this file to .env, fill in real
# values, and NEVER commit .env. Keys are read from the environment at runtime.
#   cp .env.example .env
#   set -a && . ./.env && set +a
# Without these keys the product runs fully deterministically (ADR-0006/0011);
# Groq only powers optional summaries + plan refinement, GH_TOKEN only powers the
# scripts/fetch_github.py corpus builder.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GH_TOKEN=